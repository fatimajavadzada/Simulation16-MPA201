@model List<TrainerGetVM>
<div class="d-flex flex-column m-4 w-100">
    <a asp-action="Create" asp-controller="Trainer" asp-area="Admin" class="btn btn-warning">Create New Trainer</a>
    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Name</th>
                <th scope="col">Description</th>
                <th scope="col">Image</th>
                <th scope="col">Branch Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var trainer in Model)
            {
                <tr>
                    <th scope="row">@trainer.Id</th>
                    <td>@trainer.Name</td>
                    <td>@trainer.Description</td>
                    <td>
                        <img src="/assets/images/@trainer.ImagePath" />
                    </td>
                    <td>@trainer.BranchName</td>
                    <td class="d-flex gap-2">
                        <a asp-action="Update" asp-controller="Trainer" asp-area="Admin" asp-route-id="@trainer.Id" class="btn btn-primary">Update</a>
                        <a asp-action="Delete" asp-controller="Trainer" asp-area="Admin" asp-route-id="@trainer.Id" class="btn btn-danger">Delete</a>
                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>

